# Copy this file to .env and fill in your own key -- .env is gitignored,
# never committed. Get a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (all have working defaults, only set if you need to):
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# SADIE_VOICE=Charon   # male (default); Puck is also male-range, Kore/Orus/Fenrir read female
# SADIE_MIC=0
# SADIE_OUT=
# SADIE_VOLUME=1.5
# SADIE_WORKDIR=~/.barehands-assistant
